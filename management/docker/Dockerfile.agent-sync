# appsec-agent-sync runs alongside an open-appsec agent on hosts the manager
# cannot reach by shared volume. It needs loopback access to the agent's
# orchestration API, so deploy it with network_mode: service:appsec-agent (or
# as a sidecar in the agent's pod).
#
# Build context is the management/ directory.

FROM golang:1.25-alpine AS build

WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
        -o /out/appsec-agent-sync ./cmd/appsec-agent-sync

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/appsec-agent-sync /usr/local/bin/appsec-agent-sync

# Runs as root by default: it writes into the agent's config volume, which is
# owned by root in the agent image.
ENTRYPOINT ["/usr/local/bin/appsec-agent-sync"]
