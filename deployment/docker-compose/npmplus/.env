## .env file for the NPMplus + open-appsec + open-appsec Manager stack.
## Read README.md in this directory before deploying.

## REQUIRED. NPMplus refuses to start without a timezone. Use a "TZ identifier"
## from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

## NPMplus, pinned on purpose.
##
## NPMplus removed the open-appsec attachment module on its develop branch in
## commit d70bcd71 ("breaking: drop openappsec attachment support", 24 Jul
## 2026). 2026-07-24-r1 is the last release that still ships it. Moving to a
## later release will break nginx with a load_module error. See README.md.
NPMPLUS_IMAGE=docker.io/zoeyvid/npmplus:2026-07-24-r1
NPMPLUS_DATA=./npmplus-data

## open-appsec agent and services.
APPSEC_VERSION=latest
APPSEC_CONFIG=./appsec-config
APPSEC_DATA=./appsec-data
APPSEC_LOGS=./appsec-logs
APPSEC_LOCALCONFIG=./appsec-localconfig
APPSEC_SMART_SYNC_STORAGE=./appsec-smartsync-storage

## The manager renders local_policy.yaml into APPSEC_LOCALCONFIG; leaving this
## true is what makes the agent load a newly enforced policy on its own.
APPSEC_AUTO_POLICY_LOAD=true

## Optional. Providing your email allows the open-appsec team to reach you
## about your deployment.
APPSEC_USER_EMAIL=

## Example for configuring HTTPS Proxy:
## APPSEC_HTTPS_PROXY=user:password@proxy_address:port
APPSEC_HTTPS_PROXY=

## Leave empty. A profile token from https://my.openappsec.io puts the agent
## under central SaaS management, which is mutually exclusive with the
## self-hosted manager in this stack.
APPSEC_AGENT_TOKEN=

## open-appsec Manager.
##
## No registry publishes this image yet, so the compose file carries a build
## stanza and this tag names the locally built result. Point it at a registry
## image once one exists and `docker compose pull` will use that instead.
APPSEC_MANAGER_IMAGE=openappsec-manager:local

## The admin plane is plain HTTP. Keep it on loopback and publish it through
## an NPMplus proxy host with a certificate. Set to 0.0.0.0 only if you
## understand that it exposes an unencrypted login form.
APPSEC_MANAGER_BIND=127.0.0.1
APPSEC_MANAGER_PORT=8080

APPSEC_MANAGER_ADMIN_USER=admin
## Leave the password empty to have one generated and printed to the
## manager's log on first start; change it after signing in.
APPSEC_MANAGER_ADMIN_PASSWORD=
APPSEC_MANAGER_DB_NAME=appsec_manager
APPSEC_MANAGER_EVENT_RETENTION_DAYS=30

## Postgres, used only by the manager.
APPSEC_DB_USER=postgres
APPSEC_DB_PASSWORD=pass
APPSEC_POSTGRES_STORAGE=./appsec-postgres-data
APPSEC_POSTGRES_VERSION=18

## Optional profiles:
##   juiceshop - a deliberately vulnerable backend to test the WAF against.
## Example: COMPOSE_PROFILES=juiceshop
COMPOSE_PROFILES=
