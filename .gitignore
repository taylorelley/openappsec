# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# CMake build files
**/cmake-build-debug
**/CMakeCache.txt
**/cmake_install.cmake
**/install_manifest.txt
**/CMakeFiles/
**/CTestTestfile.cmake
**/Makefile
**/*.cbp
**/CMakeScripts
**/compile_commands.json

# In source specific files
version_vars.h
makeself_help

# open-appsec Manager (management/)
# The `*.mod` rule above targets Fortran module files, but it also matches
# go.mod. Re-include Go module files anywhere under management/, so a new
# module here is not silently left out of commits.
!management/**/go.mod
management/frontend/node_modules/
management/frontend/dist/
management/backend/web/dist/*
!management/backend/web/dist/.gitkeep
management/backend/bin/
